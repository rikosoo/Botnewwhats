# Copie para .env (desenvolvimento local). Em produção na AWS use deploy/aws/.env.
# Nenhum segredo deve ser commitado.

DATABASE_URL=postgresql+asyncpg://bot:bot@localhost:5432/bot

LLM_PROVIDER=gemini            # gemini | groq
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash-lite  # groq: llama-3.3-70b-versatile (ajustar conforme disponível)
ROUTER_MODEL=                  # modelo que classifica as mensagens; vazio = LLM_MODEL
LLM_BASE_URL=                  # opcional; preenchido automaticamente pelo provider

CHATWOOT_URL=https://chat.anapaulagiraldes.com.br
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=            # token de acesso de um usuário administrador (Perfil > Token de acesso)
CHATWOOT_INBOX_ID=
CHATWOOT_BOT_TOKEN=            # token do Agent Bot
WEBHOOK_SECRET=                # segredo usado na URL do Agent Bot: /webhooks/chatwoot?token=...

GOOGLE_SERVICE_ACCOUNT_JSON=   # conteúdo JSON da chave em base64 (base64 -w0 chave.json)
GOOGLE_CALENDAR_ID=            # ex.: abc123@group.calendar.google.com

SCHEDULER_TOKEN=               # protege POST /jobs/daily
ENABLE_INTERNAL_SCHEDULER=true # APScheduler roda a rotina diária às 09:00
DOCTOR_ALERT_PHONE=            # opcional, +55DDDNUMERO, para alerta_urgente

TZ=America/Sao_Paulo
LOG_LEVEL=INFO
