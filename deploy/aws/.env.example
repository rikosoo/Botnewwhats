# Produção na AWS. Copie para deploy/aws/.env na instância e preencha.
# Gere senhas com:  openssl rand -hex 32
# (comentários sempre em linha separada; não use aspas)

# --- Domínios (registros DNS tipo A apontando para o Elastic IP) ---
BOT_DOMAIN=bot.anapaulagiraldes.com.br
CHATWOOT_DOMAIN=chat.anapaulagiraldes.com.br
ACME_EMAIL=

# --- Infra ---
POSTGRES_PASSWORD=
BOT_DB_PASSWORD=
REDIS_PASSWORD=
CHATWOOT_SECRET_KEY_BASE=
# Fixe a versão após a instalação (ex.: v4.x.y) para evitar upgrades inesperados
CHATWOOT_VERSION=latest

# E-mail do Chatwoot (opcional: convites de usuários / recuperar senha). Ex.: Amazon SES
MAILER_SENDER_EMAIL=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Bot ---
# gemini | groq  (Gemini gratuito: chave do Google AI Studio)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash-lite
# Modelo do router (classificação). Vazio = mesmo do LLM_MODEL
ROUTER_MODEL=
LLM_BASE_URL=

CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=
CHATWOOT_INBOX_ID=
CHATWOOT_BOT_TOKEN=
WEBHOOK_SECRET=

# Chave JSON da service account em base64:  base64 -w0 chave.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

SCHEDULER_TOKEN=
ENABLE_INTERNAL_SCHEDULER=true
# Opcional, formato +5516999999999
DOCTOR_ALERT_PHONE=

LOG_LEVEL=INFO
